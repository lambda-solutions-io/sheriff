{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/sheriff.full-spec.ts",
    "src/lib/test/**",
    "src/lib/cli/tests/**",
    "src/lib/fs/find-files/test*/**",
    "src/lib/fs/find-nearest/test*/**"
  ]
}
